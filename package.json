{
  "name": "brand-sentinel-workspace",
  "version": "1.0.0",
  "description": "Brand Sentinel — Intelligent Pre-Publication Brand Governance Platform (Team Vajra)",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "node server/dist/index.js",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}

